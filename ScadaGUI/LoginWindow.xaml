<Window x:Class="ScadaGUI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="360" Width="420" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Please sign in" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Username:" VerticalAlignment="Center" Width="80" />
                <TextBox x:Name="UsernameBox" Width="220" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Password:" VerticalAlignment="Center" Width="80" />
                <PasswordBox x:Name="PasswordBox" Width="220" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="LoginButton" Content="Login" Width="100" Margin="0,0,8,0" Click="LoginButton_Click" />
            <Button Content="Exit" Width="80" Click="ExitButton_Click" />
        </StackPanel>
    </Grid>
</Window>