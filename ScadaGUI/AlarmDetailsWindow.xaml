<Window x:Class="ScadaGUI.AlarmDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScadaGUI.Localization"
        xmlns:conv="clr-namespace:ScadaGUI.Converters"
        Title="{loc:Loc AlarmDetailsTitle}" Height="380" Width="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <conv:AlarmStateToColorConverter x:Key="AlarmStateToColorConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="AlarmsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc AlarmNameLabel}" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc LimitValueLabel}" Binding="{Binding LimitValue}" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc DirectionLabel}" Binding="{Binding ActivateAbove}" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc MessageLabel}" Binding="{Binding Message}" Width="2*"/>
                <DataGridTemplateColumn Header="{loc:Loc StateColumn}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding State, Converter={StaticResource AlarmStateToColorConverter}}"
                                    Padding="4,2">
                                <TextBlock Text="{Binding State}" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="AcknowledgeButton" Content="{loc:Loc AcknowledgeButton}" ToolTip="{loc:Loc AcknowledgeButtonTooltip}"
                    Width="110" Margin="0,0,10,0" Click="AcknowledgeButton_Click"/>
            <Button x:Name="EditAlarmButton" Content="{loc:Loc EditButton}" Width="80" Margin="0,0,10,0" Click="EditAlarmButton_Click"/>
            <Button x:Name="RemoveAlarmButton" Content="{loc:Loc RemoveTagButton}" ToolTip="{loc:Loc RemoveTagButtonTooltip}"
                    Width="90" Margin="0,0,10,0" Click="RemoveAlarmButton_Click"/>
            <Button x:Name="CloseButton" Content="{loc:Loc CancelButton}" Width="90" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
