<Window x:Class="ScadaGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScadaGUI"
        xmlns:loc="clr-namespace:ScadaGUI.Localization"
        xmlns:conv="clr-namespace:ScadaGUI.Converters"
        xmlns:dc="clr-namespace:DataConcentrator;assembly=DataConcentrator"
        mc:Ignorable="d"
        Title="{loc:Loc MainWindowTitle}" Height="550" Width="950"
        Closing="Window_Closing">

    <Window.Resources>
        <conv:AlarmStateToColorConverter x:Key="AlarmStateToColorConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc LanguageLabel}" ToolTip="{loc:Loc LanguageLabelTooltip}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="LanguageCombo" Width="90" ToolTip="{loc:Loc LanguageLabelTooltip}"
                      SelectionChanged="LanguageCombo_SelectionChanged" Margin="0,0,20,0"/>

            <TextBlock Text="{loc:Loc TimeZoneLabel}" ToolTip="{loc:Loc TimeZoneLabelTooltip}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="TimeZoneCombo" Width="220" ToolTip="{loc:Loc TimeZoneLabelTooltip}"
                      SelectionChanged="TimeZoneCombo_SelectionChanged" Margin="0,0,5,0"/>
            <TextBlock x:Name="TimeZoneNowText" VerticalAlignment="Center" Margin="0,0,20,0" Text="--:--:--"/>

            <TextBlock Text="{loc:Loc DateFormatLabel}" ToolTip="{loc:Loc DateFormatLabelTooltip}" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="DateFormatCombo" Width="180" ToolTip="{loc:Loc DateFormatLabelTooltip}"
                      SelectionChanged="DateFormatCombo_SelectionChanged"/>
            <TextBlock x:Name="DateFormatNowText" VerticalAlignment="Center" Margin="10,0,0,0" Text="----"
                       Cursor="Hand" ToolTip="Click to change date format" MouseLeftButtonUp="DateFormatNowText_MouseLeftButtonUp"/>
        </StackPanel>


        <DataGrid x:Name="TagsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="False">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SignalState}" Value="{x:Static dc:AlarmState.Active}">
                            <Setter Property="Background" Value="IndianRed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SignalState}" Value="{x:Static dc:AlarmState.Acknowledged}">
                            <Setter Property="Background" Value="Gold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc NameColumn}" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc DescriptionColumn}" Binding="{Binding Description}" Width="1.4*"/>
                <DataGridTextColumn Header="{loc:Loc TypeColumn}" Binding="{Binding Type}" IsReadOnly="True" Width="0.6*"/>
                <DataGridTextColumn Header="{loc:Loc AddressColumn}" Binding="{Binding IOAddress}" IsReadOnly="True" Width="0.8*"/>
                <DataGridTextColumn Header="{loc:Loc ValueColumn}" Binding="{Binding CurrentValue, StringFormat={}{0:0.00}}" IsReadOnly="True" Width="0.8*"/>


                <DataGridTemplateColumn Header="{loc:Loc ScanColumnHeader}" Width="0.6*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding OnScan, Mode=OneWay}" ToolTip="{loc:Loc ScanCheckboxTooltip}"
                                      HorizontalAlignment="Center"
                                      Checked="ScanCheckBox_Checked" Unchecked="ScanCheckBox_Unchecked">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static dc:TagType.AI}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static dc:TagType.DI}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Header="{loc:Loc WriteButton}" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static dc:TagType.AO}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static dc:TagType.DO}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBox x:Name="WriteValueBox" Width="70" Margin="0,0,5,0"
                                         PreviewTextInput="WriteValueBox_PreviewTextInput"
                                         DataObject.Pasting="WriteValueBox_Pasting" />
                                <Button Content="{loc:Loc WriteButton}" ToolTip="{loc:Loc WriteButtonTooltip}"
                                        Click="WriteButton_Click" Tag="{Binding}"
                                        CommandParameter="{Binding ElementName=WriteValueBox, Path=Text}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Header="{loc:Loc DetailsButton}" Width="0.9*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{loc:Loc DetailsButton}" ToolTip="{loc:Loc DetailsButtonTooltip}"
                                    Click="DetailsButton_Click" Tag="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static dc:TagType.AI}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button x:Name="AddButton" Content="{loc:Loc AddTagButton}" ToolTip="{loc:Loc AddTagButtonTooltip}"
                    Width="100" Height="30" Margin="0,0,10,0" Click="AddButton_Click"/>
            <Button x:Name="RemoveButton" Content="{loc:Loc RemoveTagButton}" ToolTip="{loc:Loc RemoveTagButtonTooltip}"
                    Width="100" Height="30" Margin="0,0,10,0" Click="RemoveButton_Click"/>
            <Button x:Name="EditButton" Content="{loc:Loc EditButton}" ToolTip="{loc:Loc EditButtonTooltip}"
                    Width="100" Height="30" Margin="0,0,10,0" Click="EditButton_Click"/>
            <Button x:Name="ReportButton" Content="{loc:Loc ReportButton}" ToolTip="{loc:Loc ReportButtonTooltip}"
                    Width="100" Height="30" Click="ReportButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
